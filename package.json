{
  "name": "langfuse-glance",
  "displayName": "LangFuse Glance",
  "description": "A minimal, always-current sidebar view of your LangFuse traces.",
  "version": "0.0.1",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": ["Other"],
  "activationEvents": [],
  "main": "./dist/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "langfuseGlance",
          "title": "LangFuse Glance",
          "icon": "media/icon.svg"
        }
      ]
    },
    "views": {
      "langfuseGlance": [
        {
          "id": "langfuseGlance.sidebar",
          "name": "Recent Calls",
          "type": "webview"
        }
      ]
    },
    "commands": [
      {
        "command": "langfuseGlance.configureConnection",
        "title": "LangFuse Glance: Configure Connection"
      }
    ],
    "configuration": {
      "title": "LangFuse Glance",
      "properties": {
        "langfuseGlance.pollIntervalSeconds": {
          "type": "number",
          "default": 15,
          "description": "How often to poll LangFuse for recent traces, in seconds."
        }
      }
    }
  },
  "scripts": {
    "build": "node esbuild.js",
    "watch": "node esbuild.js --watch",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src test --ext .ts",
    "test": "vitest run",
    "vscode:prepublish": "node esbuild.js --production"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@types/vscode": "^1.90.0",
    "@typescript-eslint/eslint-plugin": "^7.16.0",
    "@typescript-eslint/parser": "^7.16.0",
    "esbuild": "^0.23.0",
    "eslint": "^8.57.0",
    "typescript": "^5.5.0",
    "vitest": "^2.0.0"
  }
}
